# Copy this file to .env.notarize (gitignored). It is used only by
# tools/package_macos_dmg.sh and is never passed to Flutter as compile-time data.
#
#   cp .env.notarize.example .env.notarize
#   chmod 600 .env.notarize

# Required: a Developer ID Application certificate with its private key in the local keychain.
# The Team ID is the value in parentheses at the end of this identity.
MACOS_CODESIGN_IDENTITY="Developer ID Application: Example Inc (TEAMID)"

# Optional overrides. Leave commented unless intentionally packaging a differently configured app.
# MACOS_BUNDLE_ID=xyz.meshnotes.meshnotes
# MACOS_APP_NAME=MeshNotes

# Notary authentication: fill exactly one option below.

# Option A: App Store Connect API key (.p8 stored outside this repository).
# This flow uses APPLE_API_ISSUER instead of APPLE_TEAM_ID.
APPLE_API_KEY_PATH=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Option B: Apple ID and app-specific password.
# Uncomment this block only if not using Option A.
# This flow requires APPLE_TEAM_ID.
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Option C: a profile already stored in the macOS keychain.
# Uncomment this block only if not using Option A.
# The Team ID was stored when the profile was created.
# xcrun notarytool store-credentials meshnotes-notary --apple-id ... --team-id ... --password ...
# MACOS_NOTARY_KEYCHAIN_PROFILE=
